# Keep this repository legal and lightweight.
# The installed Garry's Mod game files, Steam content, RTX/NVIDIA binaries,
# downloaded release archives, logs, caches, crash dumps, and save data stay local.
*

# Repository metadata/docs
!.gitignore
!.gitattributes
!README.md
!README_SELF_CONTAINED.txt
!installed_packages.json

# Self-contained launcher/control scripts
!launch-gmod-rtx.sh
!open-rtxlauncher.sh
!run-gmod-rtx-via-rtxlauncher.sh
!make-self-contained.sh

# Safe setup wrappers only, not downloaded tools/caches/binaries
!_tools/
_tools/*
!_tools/install_gmod_rtx.py
!_tools/run-gmod-rtx.sh
!_tools/open-rtxlauncher.sh
!_tools/rerun-gmodpatchtool.sh

# Safe config template currently generated by launcher
!garrysmod/
garrysmod/*
!garrysmod/cfg/
garrysmod/cfg/*
!garrysmod/cfg/video.txt

# Local-only heavy/proprietary/generated data, repeated for clarity
bin/
platform/
sourceengine/
rtx-remix/
ChromiumCache/
crashes/
_logs/
.local/
_source/
backup_patches_*/
_tools/cache/
_tools/GModPatchTool/
_tools/RTXLauncher-nightly/
*.dll
*.exe
*.vpk
*.zip
*.tar.gz
*.dmp
*.log
*.dem
